---
// Light / Dark / System color-theme toggle.
// The theme is applied before paint by the inline script in BaseLayout's
// <head> (no flash). This button cycles the preference (system -> light ->
// dark), persists it to localStorage, and keeps the icon/label in sync.
---

<button
  id="theme-toggle"
  type="button"
  class="inline-flex h-8 w-8 items-center justify-center rounded-md text-zinc-500 hover:text-accent hover:bg-zinc-100 dark:hover:bg-zinc-800 transition"
  aria-label="Toggle color theme"
  title="Toggle color theme"
>
  <!-- system (monitor) -->
  <svg data-icon="system" class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="2" y="3" width="20" height="14" rx="2" />
    <path d="M8 21h8M12 17v4" />
  </svg>
  <!-- light (sun) -->
  <svg data-icon="light" class="hidden h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
  </svg>
  <!-- dark (moon) -->
  <svg data-icon="dark" class="hidden h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
  </svg>
</button>

<script>
  const KEY = 'theme';
  const order = ['system', 'light', 'dark'] as const;
  type Pref = (typeof order)[number];

  const btn = document.getElementById('theme-toggle');
  if (btn) {
    const icons = btn.querySelectorAll<HTMLElement>('[data-icon]');
    const mql = window.matchMedia('(prefers-color-scheme: dark)');

    const getPref = (): Pref => {
      const v = localStorage.getItem(KEY);
      return v === 'light' || v === 'dark' || v === 'system' ? v : 'system';
    };
    const resolve = (p: Pref) => (p === 'system' ? (mql.matches ? 'dark' : 'light') : p);

    const apply = (p: Pref) => {
      document.documentElement.setAttribute('data-theme', resolve(p));
      icons.forEach((el) => el.classList.toggle('hidden', el.dataset.icon !== p));
      const label = p[0].toUpperCase() + p.slice(1);
      btn.setAttribute('aria-label', `Color theme: ${label}. Click to change.`);
      btn.setAttribute('title', `Theme: ${label}`);
    };

    apply(getPref());

    btn.addEventListener('click', () => {
      const next = order[(order.indexOf(getPref()) + 1) % order.length];
      localStorage.setItem(KEY, next);
      apply(next);
    });

    // When following the system and no explicit choice is made, react to OS changes.
    mql.addEventListener('change', () => {
      if (getPref() === 'system') apply('system');
    });
  }
</script>
